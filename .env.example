# Copy to .env and fill in. Never commit your real .env or the service-account JSON.

# The subdomain pointing at this host. Caddy gets a Let's Encrypt cert for it.
RELAY_DOMAIN=checkin-relay.example.com

# Guards the /admin endpoints (list + revoke keys). Leave blank to disable admin entirely.
# Generate with: openssl rand -base64 32
RELAY_ADMIN_TOKEN=

# Host path to the Firebase service-account JSON the relay forwards with. Defaults to
# ./fcm-service-account.json next to this file.
# RELAY_FCM_CREDENTIALS_HOST=./fcm-service-account.json

# Optional: pin a specific image instead of :latest
# RELAY_IMAGE=ghcr.io/nc1107/check-in-relay:v1.0.0

# Optional tuning (defaults shown):
# RELAY_REGISTER_PER_HOUR=5     # per-IP registration rate
# RELAY_REGISTER_BURST=3
# RELAY_SEND_PER_MINUTE=120     # per-key send rate
# RELAY_SEND_BURST=60
# RELAY_MAX_MESSAGES=500        # device tokens per /v1/send request
